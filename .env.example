# Required.
GEMINI_API_KEY=

# An alias rather than a pinned id: pinned Gemini model ids get retired.
GENERATION_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# The reranker sits directly in the latency path and scoring relevance is a far
# easier task than writing a grounded answer, so it runs on a smaller model.
RERANK_MODEL=gemini-flash-lite-latest
RERANKER_MODE=llm          # "off" disables reranking; used as the control arm in eval

# gemini-embedding-001 natively emits 3072 dimensions, but pgvector's HNSW index
# refuses more than 2000. The pipeline asks for a Matryoshka-truncated vector and
# renormalises it. Changing this requires re-ingesting the whole corpus.
EMBEDDING_DIM=1536

# Retrieval shape.
VECTOR_TOP_K=30            # candidates from the ANN search
KEYWORD_TOP_K=30           # candidates from full-text search
RRF_K=60                   # rank-fusion smoothing constant
RERANK_TOP_N=12            # candidates handed to the reranker
CONTEXT_TOP_N=5            # chunks that actually reach the generator

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
ANSWER_CACHE_TTL=15m
