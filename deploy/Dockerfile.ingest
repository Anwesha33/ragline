FROM python:3.12-slim

# Dependencies first so a source-only change reuses the wheel layer.
COPY workers/ingest/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
 && useradd -u 10001 -m ragline

WORKDIR /app
COPY workers/ingest /app/ingest
USER ragline

# Unbuffered so container logs appear as the worker runs rather than when it
# exits — which, for a long-running worker, is never.
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "ingest.worker"]
